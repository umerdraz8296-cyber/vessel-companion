<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="28dp" android:background="#0F1015">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VESSEL AI" android:textColor="#EDEDF2" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Minimalist screen-wide assistant" android:textColor="#6B7280" android:textSize="12sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="20dp" android:background="#242736" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Gemini API Key" app:boxStrokeColor="#6366F1" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etApiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>
    <Button android:id="@+id/btnSaveKey" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:backgroundTint="#1F2230" android:textColor="#EDEDF2" android:text="Save API Key Locally" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="20dp" android:background="#242736" />
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchOverlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E5E7EB" android:text="Enable Floating Companion" />
    <Button android:id="@+id/btnEnableAccessibility" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="20dp" android:backgroundTint="#6366F1" android:textColor="#FFFFFF" android:text="Grant Reading Permission" />
</LinearLayout>